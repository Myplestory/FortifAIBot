# --- Secrets ---------------------------------------------------------------
.env
.env.local
.env.*.local

# Cryptographic material. If you have a legitimate tracked PEM (e.g. a
# public test fixture), commit it via `git add -f path/to/file.pem`.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.der
*.gpg
*.asc
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
*.pub.bak

# Generic secret-bearing filenames.
secrets/
secrets.*
*.secret
*.secrets
*.token
credentials.json
credentials.*.json
serviceAccount*.json
auth.json
.netrc

# Cloud provider credential dirs that occasionally end up in repos.
.aws/
.gcp/
.azure/
gcloud-credentials.json

# Local DB dumps and backups (often contain real data).
*.bak
*.backup
*.dump
*.sql.gz

# --- User-native runtime state --------------------------------------------
# data/session.json holds Discord user IDs, display names, and verbatim
# quiz responses; data/meta.json grows from those runs; data/*.sqlite is
# the scheduler's local DB. sessions/ archives closed sessions. None of
# this should land in a public repo. The app creates these on first run.
data/
sessions/
*.sqlite
*.sqlite3
*.db

# Defense-in-depth: stray session-archive JSONs outside `sessions/` —
# real archives are named `<discord_id>-<YYYYMMDD>T<HHMMSS>.json`.
[0-9]*-[0-9]*T[0-9]*.json
session.json
meta.json

# --- Local-only tooling ---------------------------------------------------
tools/

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# --- Virtualenvs ----------------------------------------------------------
.venv/
venv/
env/
.python-version

# --- Tool caches ----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editor / IDE state ---------------------------------------------------
.idea/
.vscode/
*.swp
*.swo

# --- OS noise -------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Logs -----------------------------------------------------------------
*.log
